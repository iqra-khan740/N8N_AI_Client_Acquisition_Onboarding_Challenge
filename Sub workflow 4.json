    {
      "parameters": {
        "jsCode": "const records = items\n  .map(item => item.json.fields)\n  .filter(record => record.Status !== \"Cold Lead\");\n\nconst report = {\n  total_leads: records.length,\n  new_leads: records.filter(r => r.Status === \"New Lead\").length,\n  proposal_sent: records.filter(r => r.Status === \"Proposal Sent\").length,\n  negotiations: records.filter(r => r.Status === \"Negotiation\").length,\n  follow_up_1: records.filter(r => r.Status === \"Follow Up 1\").length,\n  follow_up_2: records.filter(r => r.Status === \"Follow Up 2\").length,\n  calls_scheduled: records.filter(r => r.Status === \"Call Scheduled\").length,\n  won_deals: records.filter(r => r.Status === \"Won\").length,\n  lost_deals: records.filter(r => r.Status === \"Lost\").length,\n  pending_responses: records.filter(r =>\n    [\"Proposal Sent\", \"Follow Up 1\", \"Follow Up 2\"].includes(r.Status)\n  ).length,\n};\n\nreturn [\n  {\n    json: report\n  }\n];"
      },
