    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst layout = (agency, bodyHtml) => `<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#1f2937;max-width:620px\">${bodyHtml}<p style=\"margin-top:28px\">Best regards,<br><strong>${esc(agency)}</strong></p></div>`;\n\nconst e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = (e.workflow && e.workflow.name) || 'unknown workflow';\nconst html = `<h3>Workflow failed: ${esc(wf)}</h3>\n<p><strong>Failed node:</strong> ${esc(ex.lastNodeExecuted || 'n/a')}</p>\n<p><strong>Error:</strong> ${esc((ex.error && ex.error.message) || 'n/a')}</p>\n<p><strong>Execution:</strong> ${ex.url ? `<a href=\"${esc(ex.url)}\">${esc(ex.id)}</a>` : esc(ex.id || 'n/a')}</p>\n<p>Time: ${new Date().toISOString()}</p>`;\nreturn [{ json: { subject: `[n8n ERROR] ${wf}`, html } }];"
      },
      "id": "9cd37c4e-ea81-59c2-b166-18a5db94e9ad",
